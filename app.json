{
  "expo": {
    "name": "Sintonía",
    "slug": "sintonia",
    "scheme": "sintonia",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#2C1A4D"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.sintonia.mobile"
    },
    "android": {
      "package": "app.sintonia.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#2C1A4D"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
