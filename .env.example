# Proyecto de Supabase (https://supabase.com). Necesario solo para
# sincronizar y para la vinculación de pareja — sin esto la app funciona
# igual en modo 100% local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endpoint propio (no la API de Anthropic directa) que recibe
# { question, context } y devuelve { answer }. Ver la nota de seguridad en
# lib/ai.ts sobre por qué no va una API key de Anthropic en el cliente.
EXPO_PUBLIC_AI_ENDPOINT=
