# Proyecto de Supabase (https://supabase.com). Necesario solo para
# sincronizar y para la vinculación de pareja — sin esto la app funciona
# igual en modo 100% local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Endpoint propio (no la API de Anthropic directa) que recibe
# { question, context } y devuelve { answer }. Con la Edge Function del repo:
# https://<proyecto>.supabase.co/functions/v1/ai-proxy
# La API key de Anthropic NO va acá: es un secret de la función (ver README).
EXPO_PUBLIC_AI_ENDPOINT=
